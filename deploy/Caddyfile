# Un solo servidor para todo: portal en /, Transportes (estático) en /transportes/ y Operaciones (API + web) en /operaciones/.
# SITE_ADDRESS = tu dominio (HTTPS automático) o :80 para pruebas sin dominio.
{$SITE_ADDRESS::80} {
	encode gzip

	redir /transportes /transportes/ permanent
	redir /operaciones /operaciones/ permanent

	handle /operaciones/* {
		reverse_proxy operaciones:3001
	}

	handle_path /transportes/* {
		root * /srv/transportes
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /srv/portal
		file_server
	}
}
